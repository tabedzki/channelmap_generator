# Panel Configuration
EXTERNAL_PORT=5008
INTERNAL_PORT=5008
ADDRESS=localhost

# Performance Configuration
# Each process holds its own copy of every cache (atlas volumes can be
# 1 GB+), so production is memory-bound. Only raise this above 1 if RAM is
# sized for N x (base memory + atlases).
NUM_PROCS=1

# Largest atlas (decoded annotation, in MB) a user may compute with. Unset,
# it is the container's cgroup memory limit minus 512 MB for the process
# itself, and unlimited outside a container. Larger atlases are refused
# with a message instead of OOM-killing the server. allen_mouse_25um is
# 308 MB, whs_sd_rat_39um 1,074 MB, any 10um mouse atlas 4,592 MB.
# PIXELMAP_MAX_ATLAS_MB=2560

# Visitor analytics configuration
ANALYTICS_DB_PATH=/app/output/visitor_analytics.sqlite3
ANALYTICS_TRUST_PROXY_HEADERS=false
ANALYTICS_COOKIE_NAME=pixelmap_visitor_id
ANALYTICS_COOKIE_MAX_AGE_DAYS=365
ANALYTICS_COOKIE_SAMESITE=Lax
ANALYTICS_COOKIE_SECURE=false
